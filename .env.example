APP_NAME=Listee
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend origin (used by CORS + Sanctum)
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=listee
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum SPA
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Firebase Admin (server-side token verification). Provide the service
# account JSON path relative to storage/, or leave blank to disable auth in dev.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=firebase/service-account.json

# ===========================================================================
# RAZORPAY — business plan subscriptions (config/razorpay.php)
#
# Optional locally: leave the keys blank and paid upgrades fall back to the
# pre-gateway simulated invoice, so the app stays usable without a gateway.
# Fill them in to take real test-mode payments.
#
# --- 1. TEST API KEYS -------------------------------------------------------
# Dashboard (Test Mode) -> Settings -> API Keys -> Generate Test Key.
# The secret is shown ONCE. The key id starts with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
#
# --- 2. WEBHOOK SECRET ------------------------------------------------------
# You invent this value; Razorpay does not give it to you.
#   Generate:  php -r "echo bin2hex(random_bytes(24));"
# Then Dashboard -> Settings -> Webhooks -> Add New Webhook:
#   URL     {APP_URL}/api/v1/webhooks/razorpay
#           Must be reachable from the internet. Tunnel localhost first:
#           ngrok http 8000    (or: cloudflared tunnel --url http://localhost:8000)
#   Secret  the value you set below
#   Events  payment.captured, payment.failed, refund.created, refund.processed
#
# NOTE: this is NOT the same as RAZORPAY_KEY_SECRET above. Pasting the API
# secret here is the most common setup mistake — every webhook then 401s.
RAZORPAY_WEBHOOK_SECRET=
#
# --- 3. CHECKOUT APPEARANCE (optional) --------------------------------------
RAZORPAY_CHECKOUT_NAME="${APP_NAME}"
RAZORPAY_THEME_COLOR="#E23744"
#RAZORPAY_CHECKOUT_LOGO=https://your-domain/logo.png
#
# --- 4. ADVANCED (rarely changed) -------------------------------------------
#RAZORPAY_AUTO_CAPTURE=true    # off = authorized payments void after ~5 days
#RAZORPAY_TIMEOUT=30           # seconds per Razorpay API call
#RAZORPAY_BASE_URL=https://api.razorpay.com/v1
#
# After ANY change above:  php artisan config:clear
# Verify it took:          curl {APP_URL}/api/v1/config
#                          -> "payments":{"razorpay":true}
# ===========================================================================
