APP_NAME=Listee
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend origin (used by CORS + Sanctum)
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=listee
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum SPA
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Firebase Admin (server-side token verification). Provide the service
# account JSON path relative to storage/, or leave blank to disable auth in dev.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=firebase/service-account.json

# Razorpay — business plan subscriptions (config/razorpay.php). Optional in local
# development: with the keys absent, paid upgrades fall back to the pre-gateway
# simulated invoice so the flow stays demoable. REQUIRED in production.
# Keys: Dashboard → Settings → API Keys (use rzp_test_* while testing).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks. A webhook without this is rejected (401).
# Subscribe to: payment.captured, payment.failed, refund.created, refund.processed
# Webhook URL: {APP_URL}/api/v1/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CHECKOUT_NAME="${APP_NAME}"
RAZORPAY_THEME_COLOR="#E23744"
