# ── Listee backend — PRODUCTION env template (Milestone 18) ──
# Copy to `.env` on the server and fill in real values. NEVER commit the real .env.

APP_NAME=Listee
APP_ENV=production
APP_KEY=                       # php artisan key:generate
APP_DEBUG=false                # keep false in production
APP_URL=https://api.listee.app

# Frontend origin — drives CORS + Sanctum. Must be the exact SPA origin.
FRONTEND_URL=https://listee.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logging — prefer daily rotation in prod
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Database — use a least-privilege user, not root
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=listee
DB_USERNAME=listee_app
DB_PASSWORD=change-me

# Drivers — database is fine to start; move CACHE/QUEUE to redis under load
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Application caching is OFF (config/cache.php). Reads go straight to the
# database so nothing is ever stale and there is no cache to clear.
# Rate limiting still needs somewhere to count — that is CACHE_LIMITER below,
# deliberately a separate store. Setting it to `null` disables throttling on
# the PIN login, checkout and webhook endpoints.
CACHE_STORE=null
CACHE_LIMITER=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public         # run `php artisan storage:link`
# REDIS_HOST=127.0.0.1

# Mail — real SMTP for password/support mail
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@listee.app"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum SPA (bearer-token API — stateful domains only if you use cookies)
SANCTUM_STATEFUL_DOMAINS=listee.app

# Firebase Admin (server-side Google token verification + FCM push)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=firebase/service-account.json   # place under storage/app/

# SECURITY: never seed demo accounts (shared PIN 1234) in production.
SEED_DEMO_ACCOUNTS=false

# ===========================================================================
# RAZORPAY — business plan subscriptions (config/razorpay.php)
#
# REQUIRED in production. Without these, SubscriptionController::store refuses
# every paid plan upgrade — the app will not take money.
#
# --- 1. LIVE API KEYS -------------------------------------------------------
# Dashboard -> switch to LIVE Mode -> Settings -> API Keys -> Generate Live Key.
# The key id starts with rzp_live_. Never put test keys here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
#
# --- 2. WEBHOOK SECRET ------------------------------------------------------
# Live webhooks are configured SEPARATELY from test ones. Create a second
# webhook while in Live Mode, with its own freshly generated secret.
#   Generate:  php -r "echo bin2hex(random_bytes(24));"
#   URL     {APP_URL}/api/v1/webhooks/razorpay   (HTTPS, publicly reachable)
#   Events  payment.captured, payment.failed, refund.created, refund.processed
#
# NOTE: not the same value as RAZORPAY_KEY_SECRET. Fails closed — if this is
# missing or wrong, every webhook is rejected with 401 rather than trusted.
RAZORPAY_WEBHOOK_SECRET=
#
# --- 3. CHECKOUT APPEARANCE (optional) --------------------------------------
RAZORPAY_CHECKOUT_NAME="${APP_NAME}"
RAZORPAY_THEME_COLOR="#E23744"
#RAZORPAY_CHECKOUT_LOGO=https://your-domain/logo.png
#
# --- 4. ADVANCED (rarely changed) -------------------------------------------
#RAZORPAY_AUTO_CAPTURE=true    # off = authorized payments void after ~5 days
#RAZORPAY_TIMEOUT=30           # seconds per Razorpay API call
#
# After ANY change above:  php artisan config:cache
# config:cache freezes .env into the cache — skip it and the OLD key stays live.
# Verify it took:          curl {APP_URL}/api/v1/config
#                          -> "payments":{"razorpay":true}
# ===========================================================================
